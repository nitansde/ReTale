{
  "name": "retale",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#html-entity-decoder": {
      "browser": "./lib/html-entity-decoder.browser.ts",
      "default": "./lib/html-entity-decoder.server.ts"
    }
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "postinstall": "node scripts/setup-hanlp-runtime.mjs --postinstall",
    "dev": "node scripts/next-dev.mjs",
    "dev:prod": "node scripts/next-dev.mjs",
    "dev:test": "node scripts/next-test-server.mjs",
    "knowledge:worker": "node scripts/knowledge-worker.mjs",
    "storage:migrate-progress": "node --experimental-strip-types scripts/progress-message-migration.mjs",
    "storage:apply-retention": "node --experimental-strip-types scripts/apply-storage-retention.mjs",
    "storage:preview": "node --experimental-strip-types scripts/preview-storage-maintenance.mjs",
    "storage:migrate-vectors": "node --experimental-strip-types scripts/migrate-embedding-cache.mjs",
    "storage:repair-text": "node scripts/repair-persisted-text.mjs",
    "server:prod": "npm run build && node scripts/next-production-start.mjs",
    "server:test": "node scripts/next-test-server.mjs",
    "build": "node scripts/next-production-build.mjs",
    "start": "node scripts/next-production-start.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "typecheck": "RETALE_NEXT_DIST_DIR=tests/artifacts/typegen next typegen && tsc --noEmit -p tsconfig.json",
    "lint": "eslint",
    "preset:macro-process": "node scripts/process-sillytavern-preset-macros.mjs",
    "test:unit": "node scripts/run-vitest-suite.mjs unit",
    "test:api": "node scripts/run-vitest-suite.mjs api",
    "test:ui": "node scripts/run-playwright-suite.mjs",
    "test:all": "npm run test:unit && npm run test:api && npm run test:ui",
    "check:next-build-safety": "node scripts/verify-next-build-safety.mjs --evidence-dir tests/artifacts/evidence/next-build-safety",
    "verify:workspace-import": "node scripts/verify-workspace-import.mjs",
    "verify:production-freshness": "node scripts/verify-production-freshness.mjs",
    "setup:hanlp": "node scripts/setup-hanlp-runtime.mjs --smoke",
    "build:worker": "node scripts/build-knowledge-worker.mjs"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.27.2",
    "@tiptap/react": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "@xyflow/react": "^12.10.2",
    "clsx": "^2.1.1",
    "entities": "^6.0.1",
    "lucide-react": "^1.14.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5",
    "zod": "^3.25.76",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.27.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "vitest": "^3.2.4"
  }
}
